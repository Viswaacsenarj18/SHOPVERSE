# ============================================================
#  ShopVerse - .env.example
#  Copy this file to .env and fill in your actual values.
#  NEVER commit your real .env to GitHub!
# ============================================================

NODE_ENV=development

# ── LOCAL MySQL (for development on your PC) ──────────────
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=your_local_password
# DB_NAME=shopverse
# DB_SSL=false

# ── Aiven Cloud MySQL (for production) ────────────────────
# DB_HOST=your-aiven-host.aivencloud.com
# DB_PORT=your_aiven_port
# DB_USER=avnadmin
# DB_PASSWORD=your_aiven_password
# DB_NAME=shopverse
# DB_SSL=true
# DB_CA_CERT="-----BEGIN CERTIFICATE-----\n...paste ca.pem contents here...\n-----END CERTIFICATE-----"

PORT=5000
